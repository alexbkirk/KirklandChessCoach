<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ChessCoach</AssemblyName>
    <RootNamespace>ChessCoach.Desktop</RootNamespace>
    <ApplicationIcon>Assets\chesscoach.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\chesscoach.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessCoach.Core\ChessCoach.Core.csproj" />
    <ProjectReference Include="..\ChessCoach.Infrastructure\ChessCoach.Infrastructure.csproj" />
    <ProjectReference Include="..\ChessCoach.UI\ChessCoach.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>

