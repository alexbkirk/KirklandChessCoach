<Window x:Class="ChessCoach.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:ChessCoach.UI;assembly=ChessCoach.UI"
        Title="ChessCoach" Height="900" Width="1400" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <blazor:BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:App}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
