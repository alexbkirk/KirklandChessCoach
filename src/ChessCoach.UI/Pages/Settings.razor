@page "/settings"
@inject IDiagnosticsService Diagnostics
@using ChessCoach.Core.Settings
@inject ApiKeySettingsService KeySettings
@inject ThemeState Theme

<PageTitle>Settings · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Settings</MudText>
<div class="page-subtitle">Appearance, the AI coach and a health check of the app's data and tools.</div>

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h6">Appearance</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Choose a colour theme. It is saved and used every time you open the app.</MudText>
    <div class="d-flex flex-wrap gap-4">
        @foreach (var option in Themes.All)
        {
            var swatch = ThemePalettes.Swatch(option.Id);
            <button type="button" class="theme-card @(option.Id == Theme.Current.Id ? "selected" : "")" aria-pressed="@(option.Id == Theme.Current.Id ? "true" : "false")"
                    @onclick="() => ChooseThemeAsync(option.Id)">
                <div class="theme-swatch" style="background:@swatch.Background">
                    <span style="background:@swatch.Surface"></span>
                    <span style="background:@swatch.Accent"></span>
                    <span style="background:@swatch.Text"></span>
                </div>
                <div><b>@option.Name</b></div>
                <div class="eyebrow" style="text-transform:none; letter-spacing:0">@option.Description</div>
            </button>
        }
    </div>
</MudPaper>

<MudPaper Class="pa-6 mb-6" Style="max-width:640px">
    <MudText Typo="Typo.h6">AI coach</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        The coach uses an Anthropic API key. It is saved only on this computer, encrypted for your Windows account
        (in %LOCALAPPDATA%\ChessCoach), never in the database, the settings file or the repository.
    </MudText>
    @if (_key is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-3" />
    }
    else if (_key.State == StoredApiKeyState.Present)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">A key is saved (ends in …@_key.Ending).</MudAlert>
    }
    else if (_key.State == StoredApiKeyState.Unreadable)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Saved key can't be read on this account.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">No key saved yet.</MudAlert>
    }
    <MudTextField T="string" @bind-Value="_newKey" Label="@(_key?.HasFile == true ? "Replace key" : "API key")" InputType="InputType.Password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="off" />
    @if (!ApiKeySettingsService.LooksLikeAnthropicKey(_newKey))
    {
        <MudText Typo="Typo.caption" Color="Color.Warning">Anthropic keys usually start with "@ApiKeySettingsService.KeyPrefix". Check you pasted the whole key.</MudText>
    }
    @if (_key?.Message is not null)
    {
        <MudText Typo="Typo.caption" Class="d-block mt-1">@_key.Message</MudText>
    }
    <div class="d-flex gap-2 mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_newKey)" OnClick="SaveKeyAsync">Save key</MudButton>
        @if (_key?.HasFile == true)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveKeyAsync">Remove key</MudButton>
        }
    </div>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Diagnostics</MudText>

@if (_checks is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr><th style="width:48px"></th><th>Check</th><th>Detail</th></tr>
        </thead>
        <tbody>
            @foreach (var check in _checks)
            {
                <tr>
                    <td><MudIcon Icon="@IconFor(check.Status)" Color="@ColorFor(check.Status)" Size="Size.Small" /></td>
                    <td>@check.Name</td>
                    <td>@check.Detail</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="RunAsync">Run again</MudButton>
}

@code {
    private IReadOnlyList<DiagnosticCheck>? _checks;

    private ApiKeyView? _key;

    private Task ChooseThemeAsync(string id) => Theme.SetAsync(id);
    private string? _newKey;

    protected override async Task OnInitializedAsync()
    {
        _key = await KeySettings.LoadAsync();
        await RunAsync();
    }

    private async Task SaveKeyAsync()
    {
        _key = await KeySettings.SaveAsync(_newKey);
        if (_key.Succeeded) _newKey = null;
    }

    private async Task RemoveKeyAsync() => _key = await KeySettings.RemoveAsync();

    private async Task RunAsync()
    {
        _checks = null;
        _checks = await Diagnostics.RunAsync();
    }

    private static string IconFor(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => Icons.Material.Filled.CheckCircle,
        DiagnosticStatus.Warning => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Error,
    };

    private static Color ColorFor(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => Color.Success,
        DiagnosticStatus.Warning => Color.Warning,
        _ => Color.Error,
    };
}
