@page "/settings"
@inject IDiagnosticsService Diagnostics
@using ChessCoach.Core.Settings
@inject ApiKeySettingsService KeySettings
@inject ThemeState Theme
@using ChessCoach.Core.Updates
@implements IDisposable
@inject UpdateService Updates
@inject BoardView View
@inject TimeClassView TimeView

<PageTitle>Settings · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="page-title">Settings</MudText>
<div class="page-subtitle">Appearance, the AI coach and a health check of the app's data and tools.</div>

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h6" HtmlTag="h2">Appearance</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Choose a colour theme. It is saved and used every time you open the app.</MudText>
    <div class="d-flex flex-wrap gap-4">
        @foreach (var option in Themes.All)
        {
            var swatch = ThemePalettes.Swatch(option.Id);
            <button type="button" class="theme-card @(option.Id == Theme.Current.Id ? "selected" : "")" aria-pressed="@(option.Id == Theme.Current.Id ? "true" : "false")"
                    @onclick="() => ChooseThemeAsync(option.Id)">
                <div class="theme-swatch" style="background:@swatch.Background">
                    <span style="background:@swatch.Surface"></span>
                    <span style="background:@swatch.Accent"></span>
                    <span style="background:@swatch.Text"></span>
                </div>
                <div><b>@option.Name</b></div>
                <div class="eyebrow" style="text-transform:none; letter-spacing:0">@option.Description</div>
            </button>
        }
    </div>
</MudPaper>

<MudPaper Class="pa-6 mb-6" Style="max-width:640px">
    <MudText Typo="Typo.h6" HtmlTag="h2">Games to include</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        ChessCoach always imports your rapid games (10 minutes or longer). You can also include blitz and bullet. After you turn one on,
        press <b>Check for new games</b> on the Home page: the first time it searches all your past games, which can take a while.
        Once you have more than one, the header lets you switch between them.
    </MudText>
    <div class="d-flex flex-column">
        <MudCheckBox T="bool" Value="true" Disabled="true" Label="Rapid (always included)" Dense="true" />
        <MudCheckBox T="bool" Value="TimeView.Imported.Contains(TimeClasses.Blitz)" ValueChanged="ToggleBlitzAsync" Label="Blitz (3 to under 10 minutes)" Dense="true" />
        <MudCheckBox T="bool" Value="TimeView.Imported.Contains(TimeClasses.Bullet)" ValueChanged="ToggleBulletAsync" Label="Bullet (under 3 minutes)" Dense="true" />
    </div>
</MudPaper>

<MudPaper Class="pa-6 mb-6" Style="max-width:640px">
    <MudText Typo="Typo.h6" HtmlTag="h2">Board size</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">How big the boards are on the puzzle, practice, opening and game review pages. You can also change it from the header while a board is on screen.</MudText>
    <MudSlider T="int" Value="View.Size" ValueChanged="View.SetSizeAsync" Min="BoardSizes.Min" Max="BoardSizes.Max" Step="BoardSizes.Step" Immediate="false" aria-label="Board size in pixels" />
    <MudText Typo="Typo.caption">@View.Size pixels across</MudText>
</MudPaper>

<MudPaper Class="pa-6 mb-6" Style="max-width:640px">
    <MudText Typo="Typo.h6" HtmlTag="h2">About and updates</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">ChessCoach @Updates.Current. @UpdateText</MudText>
    <MudButton Variant="Variant.Outlined" Disabled="@(Updates.State is UpdateState.Checking or UpdateState.Downloading)" OnClick="() => Updates.CheckAsync()">Check for updates</MudButton>
    @if (Updates.Available is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2">The Update button is at the top of the window.</MudText>
    }
</MudPaper>

<MudPaper Class="pa-6 mb-6" Style="max-width:640px">
    <MudText Typo="Typo.h6" HtmlTag="h2">AI coach</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        The coach uses an Anthropic API key. It is saved only on this computer, encrypted for your Windows account
        (in %LOCALAPPDATA%\ChessCoach), never in the database, the settings file or the repository.
    </MudText>
    @if (_key is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-3" />
    }
    else if (_key.State == StoredApiKeyState.Present)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">A key is saved (ends in …@_key.Ending).</MudAlert>
    }
    else if (_key.State == StoredApiKeyState.Unreadable)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Saved key can't be read on this account.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">No key saved yet.</MudAlert>
    }
    <MudTextField T="string" @bind-Value="_newKey" Label="@(_key?.HasFile == true ? "Replace key" : "API key")" InputType="InputType.Password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" autocomplete="off" />
    @if (!ApiKeySettingsService.LooksLikeAnthropicKey(_newKey))
    {
        <MudText Typo="Typo.caption" Color="Color.Warning">Anthropic keys usually start with "@ApiKeySettingsService.KeyPrefix". Check you pasted the whole key.</MudText>
    }
    @if (_key?.Message is not null)
    {
        <MudText Typo="Typo.caption" Class="d-block mt-1">@_key.Message</MudText>
    }
    <div class="d-flex gap-2 mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_newKey)" OnClick="SaveKeyAsync">Save key</MudButton>
        @if (_key?.HasFile == true)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveKeyAsync">Remove key</MudButton>
        }
    </div>
</MudPaper>

<MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Diagnostics</MudText>

@if (_checks is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr><th style="width:48px"></th><th>Check</th><th>Detail</th></tr>
        </thead>
        <tbody>
            @foreach (var check in _checks)
            {
                <tr>
                    <td><MudIcon Icon="@IconFor(check.Status)" Color="@ColorFor(check.Status)" Size="Size.Small" /></td>
                    <td>@check.Name</td>
                    <td>@check.Detail</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="RunAsync">Run again</MudButton>
}

@code {
    private IReadOnlyList<DiagnosticCheck>? _checks;

    private ApiKeyView? _key;

    private Task ChooseThemeAsync(string id) => Theme.SetAsync(id);
    private string? _newKey;

    protected override async Task OnInitializedAsync()
    {
        Updates.Changed += OnUpdatesChanged;
        _key = await KeySettings.LoadAsync();
        await RunAsync();
    }

    private Task ToggleBlitzAsync(bool on) => SetImportedAsync(TimeClasses.Blitz, on);

    private Task ToggleBulletAsync(bool on) => SetImportedAsync(TimeClasses.Bullet, on);

    private Task SetImportedAsync(string timeClass, bool on) =>
        TimeView.SetImportedAsync(on ? [.. TimeView.Imported, timeClass] : TimeView.Imported.Where(c => c != timeClass));

    private void OnUpdatesChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Updates.Changed -= OnUpdatesChanged;

    private string UpdateText => Updates.State switch
    {
        UpdateState.Checking => "Checking for updates…",
        UpdateState.Available => $"Version {Updates.Available?.Version} is available.",
        UpdateState.Downloading => "Downloading the update…",
        UpdateState.UpToDate => "You have the latest version.",
        UpdateState.Failed when Updates.Available is null => Updates.Error ?? "The check did not finish.",
        _ => "",
    };

    private async Task SaveKeyAsync()
    {
        _key = await KeySettings.SaveAsync(_newKey);
        if (_key.Succeeded) _newKey = null;
    }

    private async Task RemoveKeyAsync() => _key = await KeySettings.RemoveAsync();

    private async Task RunAsync()
    {
        _checks = null;
        _checks = await Diagnostics.RunAsync();
    }

    private static string IconFor(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => Icons.Material.Filled.CheckCircle,
        DiagnosticStatus.Warning => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Error,
    };

    private static Color ColorFor(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => Color.Success,
        DiagnosticStatus.Warning => Color.Warning,
        _ => Color.Error,
    };
}
