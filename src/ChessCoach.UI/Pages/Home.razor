@page "/"
@inject IGameRepository Games
@inject ISetupService SetupFlow
@using ChessCoach.Core.Navigation
@inject NavigationManager Navigation
@inject TimeClassView TimeView
@using ChessCoach.Core.Settings
@inject AppNavigation AppNav

<PageTitle>Home · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Home</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (_summary.GameCount == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No @GamesLabel yet. ChessCoach always imports rapid games (10 minutes or longer) from chess.com, and blitz and bullet if you turn them on in Settings.
            Once you have played some, import again from the setup page.
        </MudAlert>
    }
    else
    {
        <div class="page-subtitle">
            @_summary.GameCount.ToString("N0") @GamesLabel · @_summary.MoveCount.ToString("N0") analysed moves ·
            games from @_summary.FirstGameDate to @_summary.LastGameDate
        </div>
    }

    <div class="mb-4">
        <RefreshPanel OnFinished="ReloadAsync" />
    </div>

    <MudTabs @key="_reload" Elevation="0" Rounded="true" TabPanelsClass="pt-6" ActivePanelIndex="@_tab" ActivePanelIndexChanged="SetTab">
        <MudTabPanel Text="Today">
            <div class="section-gap">
                <div class="today-grid">
                    <MudPaper Class="pa-6">
                        <div class="eyebrow mb-2">Puzzles</div>
                        <MudText Typo="Typo.h6" Class="mb-1">Find the best move</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">Positions from your own games, repeated until you find them.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SetTab(1)">Start puzzles</MudButton>
                    </MudPaper>
                    <MudPaper Class="pa-6">
                        <div class="eyebrow mb-2">Daily drill</div>
                        <MudText Typo="Typo.h6" Class="mb-1">Three blunder checks</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">A fresh set of three positions each day.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SetTab(2)">Open today's drill</MudButton>
                    </MudPaper>
                </div>
                <MudPaper Class="pa-6">
                    <WeeklyFocusCard />
                </MudPaper>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Puzzles">
            <MudPaper Class="pa-6">
                <PuzzlePanel />
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Daily drill">
            <MudPaper Class="pa-6">
                <DrillPanel />
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Openings">
            <MudPaper Class="pa-6">
                <OpeningReportCard />
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private DatabaseSummary? _summary;
    private string? _error;
    private const int TabCount = 4;

    /// <summary>The tab lives in the address, so going Back to Home shows the same one.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParameter { get; set; }

    private int _tab;
    private int _reload;

    /// <summary>"rapid games", "blitz games" or "games" (for all of them), for the headline numbers.</summary>
    private string GamesLabel => TimeView.Current is { } timeClass ? $"{timeClass} games" : "games";

    protected override void OnParametersSet() => _tab = QueryChoice.Tab(TabParameter, TabCount);

    private void SetTab(int tab)
    {
        _tab = tab;
        AppNav.ReplaceQuery(new Dictionary<string, object?> { ["tab"] = tab == 0 ? null : tab });
    }

    /// <summary>New games arrived: refresh the headline numbers and rebuild the tabs, so they show the new data.</summary>
    private async Task ReloadAsync()
    {
        _summary = await Games.GetSummaryAsync();
        _reload++;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!(await SetupFlow.GetStatusAsync()).Complete)
            {
                Navigation.NavigateTo("setup");
                return;
            }

            _summary = await Task.Run(() => Games.GetSummaryAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
