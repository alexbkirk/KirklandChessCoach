@page "/"
@inject IGameRepository Games
@inject ISetupService SetupFlow
@inject NavigationManager Navigation

<PageTitle>Home · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Home</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="page-subtitle">
        @_summary.GameCount.ToString("N0") rapid games · @_summary.MoveCount.ToString("N0") analysed moves ·
        games from @_summary.FirstGameDate to @_summary.LastGameDate
    </div>

    <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-6" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="Today">
            <div class="section-gap">
                <div class="today-grid">
                    <MudPaper Class="pa-6">
                        <div class="eyebrow mb-2">Puzzles</div>
                        <MudText Typo="Typo.h6" Class="mb-1">Find the best move</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">Positions from your own games, repeated until you find them.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _tab = 1">Start puzzles</MudButton>
                    </MudPaper>
                    <MudPaper Class="pa-6">
                        <div class="eyebrow mb-2">Daily drill</div>
                        <MudText Typo="Typo.h6" Class="mb-1">Three blunder checks</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">A fresh set of three positions each day.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => _tab = 2">Open today's drill</MudButton>
                    </MudPaper>
                </div>
                <MudPaper Class="pa-6">
                    <WeeklyFocusCard />
                </MudPaper>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Puzzles">
            <MudPaper Class="pa-6">
                <PuzzlePanel />
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Daily drill">
            <MudPaper Class="pa-6">
                <DrillPanel />
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Openings">
            <MudPaper Class="pa-6">
                <OpeningReportCard />
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private DatabaseSummary? _summary;
    private string? _error;
    private int _tab;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!(await SetupFlow.GetStatusAsync()).Complete)
            {
                Navigation.NavigateTo("setup");
                return;
            }

            _summary = await Task.Run(() => Games.GetSummaryAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
