@page "/"
@inject IGameRepository Games

<PageTitle>Home · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Home</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Your data</MudText>
        <MudText>@_summary.GameCount.ToString("N0") rapid games, @_summary.MoveCount.ToString("N0") analysed moves.</MudText>
        <MudText Typo="Typo.caption">Games from @_summary.FirstGameDate to @_summary.LastGameDate.</MudText>
    </MudPaper>
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">Board check</MudText>
        <ChessBoard Fen="rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1" MovableColor="white" Destinations="_startDests" />
    </MudPaper>
    <MudAlert Severity="Severity.Info">
        The coaching features (puzzles, daily drill, weekly focus, opening report) arrive in step 2 of the build plan.
    </MudAlert>
}

@code {
    private DatabaseSummary? _summary;
    private readonly Dictionary<string, string[]> _startDests = new() { ["e2"] = ["e3", "e4"], ["g1"] = ["f3", "h3"] };
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Games.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
