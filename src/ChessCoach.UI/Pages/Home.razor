@page "/"
@inject IGameRepository Games

<PageTitle>Home · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Home</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Your data</MudText>
        <MudText>@_summary.GameCount.ToString("N0") rapid games, @_summary.MoveCount.ToString("N0") analysed moves.</MudText>
        <MudText Typo="Typo.caption">Games from @_summary.FirstGameDate to @_summary.LastGameDate.</MudText>
    </MudPaper>
    <MudPaper Class="pa-4 mb-4">
        <PuzzlePanel />
    </MudPaper>
    <MudPaper Class="pa-4 mb-4">
        <DrillPanel />
    </MudPaper>
    <MudAlert Severity="Severity.Info">
        Still to come on this page: the weekly focus and the opening report.
    </MudAlert>
}

@code {
    private DatabaseSummary? _summary;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Games.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
