@page "/stats"

<PageTitle>Stats · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Stats</MudText>
<div class="page-subtitle">Your results and how your openings are doing.</div>

<ColorFilterBar @bind-Value="_color" />

<MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-4">
    <MudTabPanel Text="Overview">
        <OverviewPanel ColorFilter="@_color" />
    </MudTabPanel>
    <MudTabPanel Text="Openings">
        <OpeningsPanel ColorFilter="@_color" />
    </MudTabPanel>
</MudTabs>

@code {
    private string? _color;
}
