@page "/stats"

<PageTitle>Stats · ChessCoach</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Stats</MudText>

<MudButtonGroup Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="ShowAll" Color="@ColorFor(null)">All</MudButton>
    <MudButton OnClick="ShowWhite" Color="@ColorFor("white")">White</MudButton>
    <MudButton OnClick="ShowBlack" Color="@ColorFor("black")">Black</MudButton>
</MudButtonGroup>

<MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-4">
    <MudTabPanel Text="Overview">
        <OverviewPanel ColorFilter="@_color" />
    </MudTabPanel>
    <MudTabPanel Text="Openings">
        <OpeningsPanel ColorFilter="@_color" />
    </MudTabPanel>
</MudTabs>

@code {
    private string? _color;

    private void ShowAll() => _color = null;

    private void ShowWhite() => _color = "white";

    private void ShowBlack() => _color = "black";

    private Color ColorFor(string? color) => _color == color ? Color.Primary : Color.Default;
}
