<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="page-title">Page not found</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">There is no page at this address.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="">Go to Home</MudButton>
        </LayoutView>
    </NotFound>
</Router>
