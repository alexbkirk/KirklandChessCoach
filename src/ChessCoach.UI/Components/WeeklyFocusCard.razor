@using System.Globalization
@using ChessCoach.Core.Domain
@inject WeeklyFocusService FocusService

<div class="d-flex align-baseline justify-space-between flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h6" HtmlTag="h2">Your focus</MudText>
    @if (_focus is { From: { } from, To: { } to })
    {
        <MudText Typo="Typo.caption" Class="focus-muted">@Capitalised(_focus.Window) · @Month(from) – @Month(to)</MudText>
    }
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_focus is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_focus.Focus is null)
{
    <MudAlert Severity="Severity.Info">
        @(_focus.UnexplainedCount > 0
            ? "Your recent blunders aren't explained yet. Check for new games to explain them."
            : "No blunders with a clear tactic behind them in these games. Nothing to focus on yet.")
    </MudAlert>
}
else
{
    var focus = _focus.Focus;
    var top = _focus.Top;
    var max = Math.Max(1, top.Max(t => t.Count));
    <div class="focus-grid">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h3" Class="mb-1">@focus.Label</MudText>
            <MudText Typo="Typo.body1" Class="mb-3"><b>@top[0].Count</b> of the @(_focus.BlunderCount - _focus.OtherCount) blunders in these games that came down to a single tactic.</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@focus.Description</MudText>
            <MudText Typo="Typo.body2" Class="mb-2"><b>Try this:</b> @focus.TryThis</MudText>
            @if (_focus.OverallTop is { } overall)
            {
                <MudText Typo="Typo.caption" Class="focus-muted">
                    @(overall.Key == focus.Key
                        ? "It is also your most common kind across all your games."
                        : $"Across all your games, the most common kind is {overall.Label.ToLowerInvariant()}.")
                </MudText>
            }
        </div>
        <div>
            <div class="eyebrow mb-2">Most common in these games</div>
            @foreach (var kind in top)
            {
                <div class="leak-row">
                    <span class="leak-label">@kind.Label</span>
                    <span class="leak-bar"><span style="width:@Share(kind.Count, max)%"></span></span>
                    <span class="leak-count">@kind.Count</span>
                </div>
            }
            @if (_focus.OtherCount > 0)
            {
                <MudText Typo="Typo.caption" Class="focus-muted d-block mt-2">@_focus.OtherCount more had no single tactic behind them.</MudText>
            }
            @if (_focus.UnexplainedCount > 0)
            {
                <MudText Typo="Typo.caption" Class="focus-muted d-block">@_focus.UnexplainedCount aren't explained yet: Check for new games explains them.</MudText>
            }
        </div>
    </div>

    @if (_focus.Examples.Count > 0)
    {
        <div class="eyebrow mt-5 mb-2">Recent examples</div>
        <div class="focus-example-list">
            @for (var i = 0; i < _focus.Examples.Count; i++)
            {
                var index = i;
                var example = _focus.Examples[i];
                <div class="focus-example @(index == _practicing ? "selected" : "")">
                    <div>
                        <div><b>@example.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</b> vs @example.Opponent · move @example.Move · you played @example.PlayedSan</div>
                        @if (example.Headline is not null)
                        {
                            <div class="focus-muted">@example.Headline</div>
                        }
                    </div>
                    <div class="d-flex gap-2 align-center">
                        @if (example.BestUci is not null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Practice(index)">Practice</MudButton>
                        }
                        <a href="@example.Url" target="_blank" rel="noopener">game</a> <GameReviewLink Url="@example.Url" Text="review" />
                    </div>
                </div>
            }
        </div>

        @if (_practicing is { } p && p < _focus.Examples.Count && _focus.Examples[p] is { BestUci: { } bestUci } practiceExample)
        {
            <div class="mt-4">
                <PracticePosition @key="@($"{p}-{_run}")" Fen="@practiceExample.Fen" Side="@practiceExample.Color" Accept="@([bestUci])" BestUci="@bestUci" BestSan="@practiceExample.BestSan"
                                  Explanation="@practiceExample.Headline">
                    <Prompt>
                        <MudText Typo="Typo.body1" Class="mb-3"><b>@(practiceExample.Color == "white" ? "White" : "Black") to move.</b> In the game you played @practiceExample.PlayedSan. Find a better move.</MudText>
                    </Prompt>
                    <Finished Context="result">
                        <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
                    </Finished>
                </PracticePosition>
            </div>
        }
    }
}

@code {
    private WeeklyFocus? _focus;
    private string? _error;
    private int? _practicing;
    private int _run;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _focus = await Task.Run(() => FocusService.GetAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Practice(int index)
    {
        _practicing = index;
        _run++;
    }

    private void Close()
    {
        _practicing = null;
    }


    private static string Month(DateOnly date) => date.ToString("MMM yyyy", CultureInfo.InvariantCulture);

    private static string Capitalised(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private static string Share(int part, int whole) => (100.0 * part / whole).ToString("0", CultureInfo.InvariantCulture);
}
