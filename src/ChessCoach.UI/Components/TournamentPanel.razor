@using System.Globalization
@using ChessCoach.Core.Abstractions
@using ChessCoach.Core.Stats
@inject ITournamentRepository Repository
@inject IDialogService Dialogs

<div class="d-flex flex-wrap align-center justify-end gap-4 mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddGameAsync">Add tournament game</MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_prep is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_prep.Games == 0)
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">No tournament games yet</MudText>
        <MudText Typo="Typo.body1">Games you play in a tournament appear here once they are imported. Over-the-board games you add with the button above are listed too.</MudText>
    </MudPaper>
}
else
{
    <div class="kpis mb-4">
        <MudPaper Class="pa-3"><MudText Typo="Typo.caption">Games</MudText><MudText Typo="Typo.h5" HtmlTag="p">@_prep.Games.ToString("N0", CultureInfo.InvariantCulture)</MudText></MudPaper>
        <MudPaper Class="pa-3"><MudText Typo="Typo.caption">Record</MudText><MudText Typo="Typo.h5" HtmlTag="p">@RecordLabel(_prep.Record)</MudText></MudPaper>
        @foreach (var split in _prep.ByColor)
        {
            <MudPaper Class="pa-3"><MudText Typo="Typo.caption">As @split.Label.ToLowerInvariant()</MudText><MudText Typo="Typo.h5" HtmlTag="p">@RecordLabel(split.Record)</MudText></MudPaper>
        }
        <MudPaper Class="pa-3"><MudText Typo="Typo.caption">Blunder rate</MudText><MudText Typo="Typo.h5" HtmlTag="p">@Percent(_prep.BlunderRate * 100)</MudText></MudPaper>
    </div>

    <div class="stats-grid">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Openings</MudText>
            <MudSimpleTable Dense="true">
                <thead><tr><th>Opening</th><th class="text-right">Games</th><th class="text-right">Record</th></tr></thead>
                <tbody>
                    @foreach (var row in _prep.Openings)
                    {
                        <tr><td>@row.Family</td><td class="text-right">@row.Record.Games</td><td class="text-right">@RecordLabel(row.Record)</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Recent games</MudText>
            <MudSimpleTable Dense="true">
                <thead><tr><th>Date</th><th>Colour</th><th>Opponent</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var g in _prep.Recent)
                    {
                        <tr>
                            <td>@g.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@g.Color</td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.Url))
                                {
                                    <a href="@g.Url" target="_blank" rel="noopener">@g.Opponent</a>
                                }
                                else
                                {
                                    @g.Opponent
                                }
                            </td>
                            <td><MudChip T="string" Size="Size.Small" Color="@ResultColor(g.Result)">@g.Result</MudChip></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption">The five newest of @_prep.Games.ToString("N0", CultureInfo.InvariantCulture) games. @_prep.OverTheBoard.ToString("N0", CultureInfo.InvariantCulture) of them over the board.</MudText>
        </MudPaper>
    </div>
}

@code {
    private TournamentPrep? _prep;
    private string? _error;
    private int _requests;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // a response that is no longer the newest request is dropped
        var ticket = ++_requests;
        try
        {
            var games = await Repository.LoadGamesAsync();
            var moves = await Repository.LoadMoveSamplesAsync();
            var prep = await Task.Run(() => TournamentPrepCalculator.Compute(games, moves));
            if (ticket != _requests) return;
            _prep = prep;
            _error = null;
        }
        catch (Exception ex)
        {
            if (ticket == _requests) _error = ex.Message;
        }
    }

    private async Task AddGameAsync()
    {
        var dialog = await Dialogs.ShowAsync<AddTournamentGameDialog>("Add tournament game", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        await LoadAsync();
    }

    private static Color ResultColor(string result) => result switch
    {
        "win" => Color.Success,
        "loss" => Color.Error,
        _ => Color.Default,
    };

    private static string RecordLabel(Record record) =>
        $"{record.Wins}–{record.Draws}–{record.Losses}";

    private static string Percent(double value) => value.ToString("0.0", CultureInfo.InvariantCulture) + "%";
}
