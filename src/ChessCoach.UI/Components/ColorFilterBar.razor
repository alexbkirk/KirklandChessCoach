<MudButtonGroup Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="PickAllAsync" Color="@ColorFor(null)" aria-pressed="@Pressed(null)">All</MudButton>
    <MudButton OnClick="PickWhiteAsync" Color="@ColorFor("white")" aria-pressed="@Pressed("white")">White</MudButton>
    <MudButton OnClick="PickBlackAsync" Color="@ColorFor("black")" aria-pressed="@Pressed("black")">Black</MudButton>
</MudButtonGroup>

@code {
    /// <summary>The colour the stats are limited to: "white", "black", or null for both.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task PickAllAsync() => ValueChanged.InvokeAsync(null);

    private Task PickWhiteAsync() => ValueChanged.InvokeAsync("white");

    private Task PickBlackAsync() => ValueChanged.InvokeAsync("black");

    private Color ColorFor(string? color) => Value == color ? Color.Primary : Color.Default;

    /// <summary>For assistive technology: the selected colour is announced as pressed, not only shown by its colour.</summary>
    private string Pressed(string? color) => Value == color ? "true" : "false";
}
