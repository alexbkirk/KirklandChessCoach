@using ChessCoach.Core.Domain
@using ChessCoach.Core.Training
@inject PuzzleService Puzzles

<div class="d-flex align-center justify-space-between mb-2">
    <MudText Typo="Typo.h6">Find the best move</MudText>
    @if (_set is { Count: > 0 })
    {
        <MudText Typo="Typo.caption">Puzzle @(_index + 1) of @_set.Count</MudText>
    }
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_set is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_set.Count == 0)
{
    <MudAlert Severity="Severity.Info">No coached blunders in the database yet. Run the analysis first.</MudAlert>
}
else
{
    var puzzle = _set[_index];
    <MudText Typo="Typo.body2" Class="mb-2">
        @(puzzle.Color == "white" ? "White" : "Black") to move · @puzzle.Date vs <a href="@OpponentLinks.For(puzzle.Opponent)">@puzzle.Opponent</a> ·
        <a href="@puzzle.Url" target="_blank" rel="noopener">view game</a>
    </MudText>

    <PracticePosition @key="@puzzle.PositionId" Fen="@puzzle.Fen" Side="@puzzle.Color" Accept="@puzzle.Accept" BestUci="@puzzle.BestUci" BestSan="@puzzle.Note.BetterSan"
                      OnAttempt="RecordFirstAttemptAsync">
        <Prompt>
            <MudText Typo="Typo.body1" Class="mb-3">Click a piece, then the square it should go to. You have three tries.</MudText>
        </Prompt>
        <Finished Context="result">
            <MudText Typo="Typo.body2" Class="mb-2">The best line was <b>@puzzle.Note.BetterSan</b> (@puzzle.Note.BetterLine).</MudText>
            @if (!string.IsNullOrEmpty(puzzle.Note.Motif))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-0 mt-2">@puzzle.Note.Motif</MudChip>
            }
            <MudText Typo="Typo.subtitle1" Class="mt-1">@puzzle.Note.Headline</MudText>
            @foreach (var line in puzzle.Note.Why)
            {
                <MudText Typo="Typo.body2" Class="mb-1">@line</MudText>
            }
            @if (!string.IsNullOrEmpty(puzzle.Note.Pattern))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@puzzle.Note.Pattern</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(puzzle.Note.MaiaText))
            {
                <MudText Typo="Typo.caption" Class="mt-2">@puzzle.Note.MaiaText</MudText>
            }
            <MudText Typo="Typo.caption" Class="mt-2">In the game you played @puzzle.PlayedSan (eval @puzzle.Note.EvalBefore → @puzzle.Note.EvalAfter).</MudText>
            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="NextAsync">
                @(_index + 1 < _set.Count ? "Next puzzle" : "Next 5 puzzles")
            </MudButton>
        </Finished>
    </PracticePosition>
}

@code {
    private List<Puzzle>? _set;
    private int _index;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadSetAsync();

    private async Task LoadSetAsync()
    {
        try
        {
            _set = (await Task.Run(() => Puzzles.NextSetAsync())).ToList();
            _index = 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Only the first move (or giving up straight away) is scheduled, exactly as before: the extra tries are practice and
    /// do not change when the puzzle comes back.
    /// </summary>
    private async Task RecordFirstAttemptAsync(PracticeAttempt attempt)
    {
        if (_set is null || !attempt.IsFirst) return;
        await Puzzles.AnswerAsync(_set[_index], attempt.Uci, attempt.GaveUp, attempt.HintUsed);
    }

    private async Task NextAsync()
    {
        if (_set is null) return;
        if (_index + 1 < _set.Count)
        {
            _index++;
        }
        else
        {
            await LoadSetAsync();
        }
    }

}
