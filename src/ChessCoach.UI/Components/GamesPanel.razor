@using System.Globalization
@using ChessCoach.Core.Stats
@inject StatsService StatsService

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_recent is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Recent games</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>Date</th><th>Control</th><th>Colour</th><th>Opponent</th><th class="text-right">Ratings</th><th>Opening</th><th>Result</th><th>Ending</th><th></th><th></th></tr></thead>
            <tbody>
                @foreach (var g in _recent.Games)
                {
                    <tr>
                        <td>@g.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        <td>@TimeControlLabel.From(g.TimeControl)</td>
                        <td>@g.Color</td>
                        <td>@g.Opponent</td>
                        <td class="text-right">@g.MyRating – @g.OppRating</td>
                        <td>@g.Family</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@ResultColor(g.Result)">@g.Result</MudChip></td>
                        <td>@g.Ending</td>
                        <td><a href="review/@g.Id">review</a></td>
                        <td>@if (!string.IsNullOrEmpty(g.Url)) { <a href="@g.Url" target="_blank" rel="noopener">view</a> }</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <div class="d-flex align-center gap-4 mt-3">
            <MudText Typo="Typo.caption">Showing @_recent.Games.Count.ToString("N0", CultureInfo.InvariantCulture) of @_recent.Total.ToString("N0", CultureInfo.InvariantCulture) games.</MudText>
            @if (_recent.Remaining > 0 && _count < MaxShown)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ShowMoreAsync">Show more (@Math.Min(RecentGamesCalculator.PageSize, _recent.Remaining) more)</MudButton>
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter] public string? ColorFilter { get; set; }

    /// <summary>How many games to show; the page keeps it in the address, so going Back shows the same ones.</summary>
    [Parameter] public int Shown { get; set; } = RecentGamesCalculator.PageSize;

    [Parameter] public EventCallback<int> ShownChanged { get; set; }

    public const int MaxShown = 5000;

    private RecentGames? _recent;
    private string? _error;
    private string? _loadedColor;
    private bool _loaded;
    private int _count = RecentGamesCalculator.PageSize;
    private int _requests;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedColor == ColorFilter && _count == Shown) return;
        _count = Shown;
        await LoadAsync();
    }

    private async Task ShowMoreAsync()
    {
        _count = Math.Min(_count + RecentGamesCalculator.PageSize, MaxShown);
        await ShownChanged.InvokeAsync(_count);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // a response that is no longer the newest request is dropped
        var ticket = ++_requests;
        var color = ColorFilter;
        var count = _count;
        try
        {
            var result = await Task.Run(() => StatsService.GetRecentGamesAsync(color, count));
            if (ticket != _requests) return;
            _recent = result;
            _loaded = true;
            _loadedColor = color;
            _error = null;
        }
        catch (Exception ex)
        {
            if (ticket == _requests) _error = ex.Message;
        }
    }

    private static Color ResultColor(string result) => result switch
    {
        "win" => Color.Success,
        "loss" => Color.Error,
        _ => Color.Default,
    };
}
