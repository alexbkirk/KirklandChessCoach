@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="chess-board cg-wrap"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _board;
    private DotNetObjectReference<ChessBoard>? _self;

    /// <summary>FEN of the position to show.</summary>
    [Parameter, EditorRequired] public string Fen { get; set; } = "";

    /// <summary>Legal destinations: from-square to list of to-squares (chess.js output, computed by the caller).</summary>
    [Parameter] public IReadOnlyDictionary<string, string[]> Destinations { get; set; } = new Dictionary<string, string[]>();

    /// <summary>Colour allowed to move ("white" or "black"). Null or empty = nothing movable.</summary>
    [Parameter] public string? MovableColor { get; set; }

    [Parameter] public string Orientation { get; set; } = "white";

    /// <summary>Raised with the UCI move (e.g. "e2e4") when the user completes a move.</summary>
    [Parameter] public EventCallback<string> OnMove { get; set; }

    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChessCoach.UI/js/board-interop.js");
        _self = DotNetObjectReference.Create(this);
        _board = await _module.InvokeAsync<IJSObjectReference>("create", _element, _self, new
        {
            fen = Fen,
            orientation = Orientation,
            movableColor = MovableColor,
            dests = Destinations,
        });
        _ready = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _board is not null)
        {
            await _board.InvokeVoidAsync("setPosition", Fen, Destinations, MovableColor, Orientation);
        }
    }

    [JSInvokable]
    public async Task HandleMove(string uci)
    {
        if (OnMove.HasDelegate) await OnMove.InvokeAsync(uci);
    }

    public async ValueTask DisposeAsync()
    {
        if (_board is not null) await _board.InvokeVoidAsync("destroy");
        if (_board is not null) await _board.DisposeAsync();
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}
